{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://prescrimed.local/schema/procedimento.json",
  "title": "Procedimento do Box de Emergência",
  "type": "object",
  "required": ["schema_version", "procedimento"],
  "properties": {
    "schema_version": { "type": "string" },
    "procedimento": {
      "type": "object",
      "required": [
        "id", "nome", "categoria", "urgencia", "tempo_estimado_min", "dificuldade",
        "indicacoes", "contraindicacoes", "material", "anestesia", "posicionamento",
        "tecnica", "confirmacao", "complicacoes", "cuidados_pos", "registro_minimo",
        "sindromes_relacionadas", "fonte", "versao", "revisor_clinico"
      ],
      "properties": {
        "id": { "type": "string", "pattern": "^BOX-[0-9]{2}$" },
        "nome": { "type": "string", "minLength": 3 },
        "categoria": {
          "enum": ["via_aerea", "acesso", "hemodinamica", "toracica", "neurologica", "urinaria", "digestiva", "ferida", "musculoesqueletica", "diagnostica"]
        },
        "urgencia": { "enum": ["emergencia", "urgente", "eletivo_urgente"] },
        "tempo_estimado_min": { "type": "integer", "minimum": 1 },
        "dificuldade": { "type": "integer", "minimum": 1, "maximum": 3 },
        "indicacoes": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 5 } },
        "contraindicacoes": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 5 } },
        "material": { "type": "array", "minItems": 5, "items": { "type": "string", "minLength": 3 } },
        "anestesia": { "type": "string", "minLength": 5 },
        "posicionamento": { "type": "string", "minLength": 5 },
        "tecnica": { "type": "array", "minItems": 8, "items": { "type": "string", "minLength": 10 } },
        "confirmacao": { "type": "array", "minItems": 2, "items": { "type": "string", "minLength": 5 } },
        "complicacoes": {
          "type": "array",
          "minItems": 4,
          "items": {
            "type": "object",
            "required": ["complicacao", "conduta"],
            "properties": {
              "complicacao": { "type": "string", "minLength": 5 },
              "conduta": { "type": "string", "minLength": 5 }
            }
          }
        },
        "cuidados_pos": { "type": "array", "minItems": 3, "items": { "type": "string", "minLength": 5 } },
        "registro_minimo": { "type": "array", "minItems": 4, "items": { "type": "string", "minLength": 3 } },
        "sindromes_relacionadas": { "type": "array", "minItems": 2, "items": { "type": "string" } },
        "fonte": { "type": "string", "minLength": 3 },
        "versao": { "type": "string" },
        "revisor_clinico": { "type": ["string", "null"] }
      },
      "additionalProperties": true
    }
  }
}
